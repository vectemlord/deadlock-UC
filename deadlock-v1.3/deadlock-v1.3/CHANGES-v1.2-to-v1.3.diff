+   summary:'The 5.3 KB JSON state sent 30x/s to every client is replaced by a quantized binary frame (29-byte header + 19 bytes per player + 10 per bullet).',
+   before:'ws.send(JSON.stringify({type:\'state\', state:game.snapshot(), ...}))   // ~5300 B',
+   after:'ws.send(encodeState(game, room.rv))   // ~250 B: int16 x/z*50, u16 angle, u8 hp/cooldowns'},
+  {id:2, tag:'PROTOCOL', title:'Static data sent once', files:['server/index.js','src/app.js'],
+   summary:'Names, roles, teams and max HP go in a "roster" message only when the roster changes. Feed events are sent once as a reliable message instead of the last 12 every tick.',
+   before:'players:[{id,name,role,team,maxHp,...}]  events:[last 12]   // every tick',
+   after:'{type:\'roster\',v,players}  {type:\'events\',events:[new only]}  // on change'},
+  {id:3, tag:'SERVER', title:'Backpressure: drop stale frames', files:['server/index.js'],
+   summary:'A congested client no longer builds up a queue of old state. Frames are skipped once more than 16 KiB is buffered (v1.2 allowed 256 KB, about 1 s of lag).',
+   before:'if (ws.bufferedAmount < 256000) ws.send(json)',
+   after:'if (ws.bufferedAmount > MAX_BUFFER) {dropped++; return;}  // MAX_BUFFER = 16 KiB'},
+  {id:4, tag:'SERVER', title:'Serialize once, cheaper spectators, idle rooms', files:['server/index.js'],
+   summary:'One encode per room per tick is shared by all recipients. Spectators get 15 Hz (10 Hz when the server is behind). Lobby and finished rooms send a keep-alive every 500 ms.',
+   before:'for (const ws of everyone) send(ws, {type:\'state\', state:game.snapshot()})   // N stringifies',
+   after:'const frame = encodeState(game, rv); for (const ws of players) sendFrame(ws, frame)'},
+  {id:5, tag:'CLIENT', title:'Snapshot interpolation', files:['src/netcode.js','src/app.js'],
+   summary:'Other players are drawn about 2 ticks in the past, interpolated between two real snapshots on the server tick timeline, so dropped or late frames no longer cause stutter.',
+   before:'arena.render(state, ...)   // latest packet, 30 Hz steps',
+   after:'arena.render(buffer.sample(now), ...)   // delay adapts to measured jitter (50-250 ms)'},
